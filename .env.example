# Azure Speech credentials — copy to .env and fill in your values.
# Do NOT commit .env to version control.

# Required: Azure Speech resource key and region
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
# Southeast Asia supports both REST enhanced mode and MAI streaming (checked Oct 10, 2026).
# Use this resource's actual key and endpoint; changing only the region is not sufficient.
# East US 2 supports MAI streaming but is not listed for REST enhanced mode.

# Optional: Separate resource for REST enhanced modes (fast_llm, fast_mai_1_5, fast_mai_2).
# Defaults to the values above if not set.
# LLM_AZURE_SPEECH_KEY=
# LLM_AZURE_SPEECH_REGION=
# LLM_AZURE_SPEECH_ENDPOINT=

# Optional: Separate resource for realtime_refine (MRS preview).
# Defaults to the values above if not set.
# REFINE_AZURE_SPEECH_KEY=
# REFINE_AZURE_SPEECH_REGION=
# REFINE_AZURE_SPEECH_ENDPOINT=

# realtime_mai_2 uses the same AZURE_SPEECH_KEY, AZURE_SPEECH_REGION, and
# AZURE_SPEECH_ENDPOINT above. No separate MAI key or endpoint is required.
# Use a Speech resource in a documented supported region and Speech SDK >=1.52.0.

# Optional, opt-in realtime_mai_2_api only: MAI Realtime endpoint and deployed model.
# Same AZURE_SPEECH_KEY/resource as SDK; this is a different protocol route, not a new key.
# Obtain the endpoint from the resource's "Azure MAI Realtime API v1.0" property.
# The REST/SDK Speech endpoint is not interchangeable with the Realtime API root.
# MAI_REALTIME_ENDPOINT=https://your-resource-name.services.ai.azure.com
# MAI_REALTIME_DEPLOYMENT=MAI-Transcribe-2-Streaming

# Optional azure_whisper: existing Azure OpenAI Whisper deployment, not Whisper v3.
# Use the endpoint, key and deployment from the same Azure resource.
# WHISPER_AZURE_KEY=
# WHISPER_AZURE_ENDPOINT=https://your-resource-name.openai.azure.com
# WHISPER_AZURE_DEPLOYMENT=Whisper
# WHISPER_AZURE_MODEL_VERSION=001
# Match the existing deployment's request quota; this does not change Azure quota.
# WHISPER_AZURE_REQUESTS_PER_MINUTE=3
