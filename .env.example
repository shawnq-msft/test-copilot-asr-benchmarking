# Azure Speech credentials — copy to .env and fill in your values.
# Do NOT commit .env to version control.

# Required: Azure Speech resource key and region
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# Optional: Separate resource for LLM-enhanced services (fast_llm, fast_mai).
# Defaults to the values above if not set.
# LLM_AZURE_SPEECH_KEY=
# LLM_AZURE_SPEECH_REGION=
# LLM_AZURE_SPEECH_ENDPOINT=

# Optional: Separate resource for realtime_refine (MRS preview).
# Defaults to the values above if not set.
# REFINE_AZURE_SPEECH_KEY=
# REFINE_AZURE_SPEECH_REGION=
# REFINE_AZURE_SPEECH_ENDPOINT=
